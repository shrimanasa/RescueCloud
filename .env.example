POSTGRES_USER=your_postgres_username
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=rescuecloud_ehr

MINIO_ROOT_USER=your_minio_username
MINIO_ROOT_PASSWORD=your_minio_password

BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BACKUP_LEDGER_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# JWT & API Security (REQUIRED - application fails startup if unset or < 32 chars)
JWT_SECRET_KEY=generate_with_openssl_rand_hex_32_never_commit_real_keys
ACCESS_TOKEN_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:3000,http://127.0.0.1:5500

# Administrative Credentials (REQUIRED - application fails startup if unset)
ADMIN_USERNAME=admin@yourhospital.org
ADMIN_PASSWORD=generate_a_strong_unique_admin_password_here

# Optional Clinical Doctor Credentials
DOCTOR_USERNAME=doctor@yourhospital.org
DOCTOR_PASSWORD=generate_a_strong_doctor_password_here


# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_in_prod
GRAFANA_PORT=3000

# Alert thresholds
ANOMALY_ALERT_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=300
